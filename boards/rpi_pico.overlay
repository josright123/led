#include <zephyr/dt-bindings/gpio/gpio.h>
#include <zephyr/dt-bindings/pinctrl/rpi-pico-rp2040-pinctrl.h>

/*
 * DM9051 wiring for Raspberry Pi Pico (RP2040)
 * SPI0: MISO=GPIO16, SCK=GPIO18, MOSI=GPIO19
 * CS: GPIO17, INT: GPIO20 (active low), RESET: GPIO21 (active low)
 */

&pinctrl {
	spi0_dm9051_default: spi0_dm9051_default {
		group1 {
			pinmux = <SPI0_RX_P16>, <SPI0_SCK_P18>, <SPI0_TX_P19>;
		};
	};
};

&spi0 {
	pinctrl-0 = <&spi0_dm9051_default>;
	pinctrl-names = "default";
	cs-gpios = <&gpio0 17 GPIO_ACTIVE_LOW>;
	status = "okay";

	dm9051: ethernet@0 {
		compatible = "davicom,dm9051";
		reg = <0>;
		spi-max-frequency = <12000000>;
		int-gpios = <&gpio0 20 GPIO_ACTIVE_LOW>;
		reset-gpios = <&gpio0 21 GPIO_ACTIVE_LOW>;
		status = "okay";
	};
};
